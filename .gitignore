python/app/models/*.pt
python/app/models/*.pkl
python/app/models/*.joblib
python/app/models/*.onnx
python/app/models/*.keras

# =========================
# Training Outputs
# =========================
python/app/training/output/
python/app/training/logs/
python/app/training/checkpoints/
python/app/training/runs/

